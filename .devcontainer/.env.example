# Copy to .env (this folder) and adjust for your local Postgres.
# Without .env, the app uses the bundled streammaster-db service.

localWorkspaceFolderBasename=StreamMaster

# Host/LAN IP that VLC and other clients can reach (not localhost)
STREAMMASTER_BASEHOSTURL=http://192.168.1.100:7095

POSTGRES_HOST=streammaster-db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sm123
POSTGRES_DB=StreamMaster
